{
  "name": "logicbench",
  "productName": "LogicBench",
  "appId": "com.logicbench.app",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop-class local-first workbench for digital electronics, microcontrollers, and embedded systems engineering.",
  "author": "Mehdi Zahedi (مهدی زاهدی)",
  "copyright": "Copyright © 2026 Mehdi Zahedi",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_DEV_SERVER=true tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --packages=external --bundle --outfile=server.js",
    "start": "node server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
